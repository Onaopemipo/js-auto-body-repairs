{
  "name": "js-auto-body-repairs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:foundation": "node scripts/validateFoundation.mjs",
    "validate": "npm run validate:foundation && npm run validate:brand-core && npm run validate:navigation && npm run validate:homepage && npm run validate:motion && npm run validate:three && npm run validate:hero-media && npm run validate:content-pages && npm run validate:quote-form && npm run validate:contact && npm run validate:gallery && npm run validate:gallery-media && npm run validate:seo && npm run validate:performance && npm run validate:production && npm run validate:analytics && npm run validate:namecheap && npm run typecheck && npm run lint && npm run build",
    "brand:process": "node scripts/brand/processLogo.mjs",
    "validate:brand-core": "node scripts/validateBrandCore.mjs",
    "validate:navigation": "node scripts/validateNavigation.mjs",
    "validate:homepage": "node scripts/validateHomepage.mjs",
    "validate:motion": "node scripts/validateMotionFoundation.mjs",
    "validate:three": "node scripts/validateThreeFoundation.mjs",
    "validate:hero-media": "node scripts/validatePhotographicHero.mjs",
    "validate:content-pages": "node scripts/validateContentPages.mjs",
    "validate:quote-form": "node scripts/validateQuoteForm.mjs",
    "validate:contact": "node scripts/validateContactPage.mjs",
    "validate:gallery": "node scripts/validateGallery.mjs",
    "gallery:process": "node scripts/gallery/processGalleryMedia.mjs",
    "gallery:rebuild": "npm run gallery:process && npx prettier --write src/content/generated/gallery-projects.ts",
    "validate:gallery-media": "node scripts/validateGalleryMedia.mjs",
    "validate:seo": "node scripts/validateSeo.mjs",
    "validate:performance": "node scripts/validatePerformance.mjs",
    "validate:production": "node scripts/validateProductionReadiness.mjs",
    "validate:analytics": "node scripts/validateAnalytics.mjs",
    "validate:namecheap": "node scripts/validateNamecheapDeployment.mjs",
    "deploy:package": "npm run validate && node scripts/deployment/buildPackage.mjs && npm run deploy:inspect",
    "deploy:inspect": "node scripts/deployment/inspectPackage.mjs",
    "deploy:verify-env": "node scripts/deployment/verifyEnvironment.mjs",
    "deploy:smoke": "node scripts/deployment/smokeTest.mjs",
    "cpanel:build": "node scripts/deployment/cpanelBuild.mjs",
    "validate:linux-deployment": "node scripts/validateLinuxDeployment.mjs",
    "deploy:linux": "npm run validate && node scripts/deployment/buildLinuxStandalone.mjs && npm run deploy:linux:inspect",
    "deploy:linux:inspect": "node scripts/deployment/inspectLinuxStandalone.mjs",
    "postlaunch:production": "node scripts/postlaunch/verifyProduction.mjs",
    "postlaunch:quote": "node scripts/postlaunch/verifyQuoteDelivery.mjs",
    "postlaunch:analytics": "node scripts/postlaunch/verifyAnalytics.mjs",
    "postlaunch:mobile": "node scripts/postlaunch/verifyMobile.mjs",
    "postlaunch:logs": "bash scripts/postlaunch/readProductionLogs.sh",
    "postlaunch:lighthouse": "lighthouse https://jsautobodyrepairs.com.au --view --preset=desktop",
    "postlaunch:lighthouse:mobile": "lighthouse https://jsautobodyrepairs.com.au --view --form-factor=mobile --screenEmulation.mobile=true",
    "postlaunch:verify": "npm run postlaunch:production && npm run postlaunch:analytics && npm run postlaunch:mobile"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "lighthouse": "^13.4.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  }
}
